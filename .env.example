# ==============================================================================
# AI-Powered Linux Malware & Privilege-Escalation Investigation Workspace
# Environment Configuration Template
# 
# IMPORTANT: DO NOT commit actual secrets or credentials to source control.
# Copy this file to `.env` in the appropriate directories and set actual values.
# ==============================================================================

# ------------------------------------------------------------------------------
# General & Application Settings
# ------------------------------------------------------------------------------
PROJECT_NAME="AI-Powered Linux Malware & Privilege-Escalation Investigation Workspace"
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# CORS Configuration (Backend)
# Comma-separated list or JSON array of allowed origins
# ------------------------------------------------------------------------------
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# Frontend Settings
# Used by Vite (prefixed with VITE_)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# ------------------------------------------------------------------------------
# Supabase PostgreSQL & Auth (Backend)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# Anthropic Claude API (Backend Only)
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=your-anthropic-api-key-placeholder
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
